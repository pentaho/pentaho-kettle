<?xml version="1.0" encoding="UTF-8"?>
<transformation>
  <info>
    <name>generate_rows_text_output</name>
    <trans_type>Normal</trans_type>
    <trans_status>0</trans_status>
    <directory>/</directory>
  </info>
  <order>
    <hop>
      <from>Generate rows</from>
      <to>Text file output</to>
      <enabled>Y</enabled>
    </hop>
  </order>
  <step>
    <name>Generate rows</name>
    <type>RowGenerator</type>
    <copies>1</copies>
    <limit>3</limit>
    <fields>
      <field>
        <name>id</name>
        <type>Integer</type>
        <value>1</value>
      </field>
    </fields>
    <GUI>
      <xloc>100</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step>
    <name>Text file output</name>
    <type>TextFileOutput</type>
    <copies>1</copies>
    <file>
      <name>/tmp/docker-it/output/generate_rows_text_output</name>
      <extention>txt</extention>
      <append>N</append>
      <split>N</split>
      <add_stepnr>N</add_stepnr>
      <add_partnr>N</add_partnr>
      <add_date>N</add_date>
      <add_time>N</add_time>
      <create_parent_folder>Y</create_parent_folder>
    </file>
    <separator>;</separator>
    <enclosure>"</enclosure>
    <fields>
      <field>
        <name>id</name>
        <type>Integer</type>
        <format/>
        <currency/>
        <decimal/>
        <group/>
        <length>-1</length>
        <precision>-1</precision>
        <nullif/>
      </field>
    </fields>
    <GUI>
      <xloc>300</xloc>
      <yloc>100</yloc>
      <draw>Y</draw>
    </GUI>
  </step>
  <step_error_handling>
  </step_error_handling>
</transformation>
