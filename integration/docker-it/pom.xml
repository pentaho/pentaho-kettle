<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.pentaho.di</groupId>
    <artifactId>pdi</artifactId>
    <version>11.1.0.0-SNAPSHOT</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>pdi-docker-integration-tests</artifactId>
  <packaging>jar</packaging>

  <name>PDI Docker Integration Tests</name>
  <description>Runs KTR files in the PDI build of the commit under test, in Pan, Carte and Pentaho Server containers</description>

  <properties>
    <docker-maven-plugin.version>0.48.1</docker-maven-plugin.version>
    <junit-bom.version>6.0.3</junit-bom.version>

    <!-- Registry prefix of the base images. Empty for Docker Hub. -->
    <pentaho.docker.pull.host>repo.pentaho.com/pnt-docker/</pentaho.docker.pull.host>

    <pdi-plugin-tester.pdi-version>11.1</pdi-plugin-tester.pdi-version>
    <pdi-plugin-tester.pdi-home>/home/devuser/pentaho/design-tools/data-integration</pdi-plugin-tester.pdi-home>
    <pdi-plugin-tester.server-home>/home/devuser/pentaho/pentaho-server</pdi-plugin-tester.server-home>
    <pdi-plugin-tester.docker-dir>${project.basedir}/docker</pdi-plugin-tester.docker-dir>
    <pdi-plugin-tester.ssh-dir>${project.basedir}/src/test/resources/ssh</pdi-plugin-tester.ssh-dir>
    <pdi-plugin-tester.test-network-name>pdi-test-network</pdi-plugin-tester.test-network-name>

    <pdi-plugin-tester.postgres-version>16.3</pdi-plugin-tester.postgres-version>
    <pdi-plugin-tester.postgres-password>postgres</pdi-plugin-tester.postgres-password>
    <pdi-plugin-tester.carte-host-port>9081</pdi-plugin-tester.carte-host-port>
    <pdi-plugin-tester.server-host-port>8080</pdi-plugin-tester.server-host-port>
    <pdi-plugin-tester.startup-timeout-ms>300000</pdi-plugin-tester.startup-timeout-ms>
    <pdi-plugin-tester.server-startup-timeout-ms>900000</pdi-plugin-tester.server-startup-timeout-ms>

    <!-- PAN,CARTE,SERVER by default. -->
    <pdi-plugin-tester.execution-types>PAN,CARTE,SERVER</pdi-plugin-tester.execution-types>
    <pdi-plugin-tester.skip-pentaho-server-container>false</pdi-plugin-tester.skip-pentaho-server-container>
    <pdi-plugin-tester.skip-postgres-container>false</pdi-plugin-tester.skip-postgres-container>
    <pdi-plugin-tester.skip-ssh-containers>false</pdi-plugin-tester.skip-ssh-containers>

    <rerunFailingTestsCount>2</rerunFailingTestsCount>
    <groups/>
    <excludedGroups/>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <id>default-jar</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-install-plugin</artifactId>
        <executions>
          <execution>
            <id>default-install</id>
            <phase>none</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- Off by default. Run with -DrunDockerITs. Without it, mvn verify starts no container. -->
    <profile>
      <id>docker-its</id>
      <activation>
        <property>
          <name>runDockerITs</name>
        </property>
      </activation>
      <dependencies>
        <!-- The PDI zip of the commit under test. Build it first with: mvn install -pl assemblies/client -am -->
        <dependency>
          <groupId>org.pentaho.di</groupId>
          <artifactId>pdi-ce</artifactId>
          <version>${project.version}</version>
          <type>zip</type>
          <scope>test</scope>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-dependency-plugin</artifactId>
            <version>3.8.1</version>
            <executions>
              <execution>
                <id>unpack-pdi-ce</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.pentaho.di</groupId>
                      <artifactId>pdi-ce</artifactId>
                      <version>${project.version}</version>
                      <type>zip</type>
                      <outputDirectory>${project.build.directory}/pdi-ce</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>io.fabric8</groupId>
            <artifactId>docker-maven-plugin</artifactId>
            <version>${docker-maven-plugin.version}</version>
            <configuration>
              <autoCreateCustomNetworks>true</autoCreateCustomNetworks>
              <images>
                <!-- PostgreSQL. Runs the database setup in docker/postgres. The Server connects to it. -->
                <image>
                  <name>postgres:${pdi-plugin-tester.postgres-version}</name>
                  <alias>postgresDatabase</alias>
                  <run>
                    <skip>${pdi-plugin-tester.skip-postgres-container}</skip>
                    <containerNamePattern>postgres-%t</containerNamePattern>
                    <platform>linux/amd64</platform>
                    <network>
                      <mode>custom</mode>
                      <name>${pdi-plugin-tester.test-network-name}</name>
                      <alias>pdi-postgres</alias>
                    </network>
                    <env>
                      <POSTGRES_DB>testdb</POSTGRES_DB>
                      <POSTGRES_USER>postgres</POSTGRES_USER>
                      <POSTGRES_PASSWORD>${pdi-plugin-tester.postgres-password}</POSTGRES_PASSWORD>
                    </env>
                    <volumes>
                      <bind>
                        <volume>${pdi-plugin-tester.docker-dir}/postgres:/docker-entrypoint-initdb.d:ro</volume>
                      </bind>
                    </volumes>
                  </run>
                </image>

                <!-- PDI. The base image plus the unpacked pdi-ce zip of the commit under test. -->
                <image>
                  <name>pdi-docker-it:${pdi-plugin-tester.pdi-version}</name>
                  <alias>pdi</alias>
                  <build>
                    <from>${pentaho.docker.pull.host}automation/pdi-client:${pdi-plugin-tester.pdi-version}</from>
                    <assemblies>
                      <assembly>
                        <name>pdi-ce</name>
                        <targetDir>/tmp/docker-it</targetDir>
                        <inline>
                          <fileSets>
                            <fileSet>
                              <directory>${project.build.directory}/pdi-ce/data-integration</directory>
                              <outputDirectory>data-integration</outputDirectory>
                            </fileSet>
                          </fileSets>
                        </inline>
                      </assembly>
                    </assemblies>
                    <runCmds>
                      <run>rm -rf ${pdi-plugin-tester.pdi-home} &amp;&amp; mkdir -p ${pdi-plugin-tester.pdi-home} &amp;&amp; cp -a /tmp/docker-it/data-integration/. ${pdi-plugin-tester.pdi-home}/</run>
                      <run>chmod +x ${pdi-plugin-tester.pdi-home}/*.sh</run>
                      <run>rm -rf /tmp/docker-it</run>
                    </runCmds>
                  </build>
                  <run>
                    <containerNamePattern>pdi-%t</containerNamePattern>
                    <platform>linux/amd64</platform>
                    <entryPoint>
                      <arg>/bin/sh</arg>
                      <arg>-c</arg>
                      <arg>tail -f /dev/null</arg>
                    </entryPoint>
                    <network>
                      <mode>custom</mode>
                      <name>${pdi-plugin-tester.test-network-name}</name>
                    </network>
                    <ports>
                      <port>${pdi-plugin-tester.carte-host-port}:8080</port>
                    </ports>
                    <volumes>
                      <bind>
                        <volume>${pdi-plugin-tester.ssh-dir}/test-keys/test_rsa:/tmp/docker-it/ssh/test_rsa:ro</volume>
                      </bind>
                    </volumes>
                  </run>
                </image>

                <!-- Pentaho Server. The base image, the kettle jars and plugins of the commit, and the database settings. -->
                <image>
                  <name>pentaho-server-docker-it:${pdi-plugin-tester.pdi-version}</name>
                  <alias>pentaho-server</alias>
                  <build>
                    <from>${pentaho.docker.pull.host}automation/pentaho-server:${pdi-plugin-tester.pdi-version}-pgsql</from>
                    <assemblies>
                      <assembly>
                        <name>pdi-overlay</name>
                        <targetDir>/tmp/docker-it</targetDir>
                        <inline>
                          <fileSets>
                            <fileSet>
                              <directory>${project.build.directory}/pdi-ce/data-integration/lib</directory>
                              <includes>
                                <include>kettle-*.jar</include>
                              </includes>
                              <outputDirectory>overlay/lib</outputDirectory>
                            </fileSet>
                            <fileSet>
                              <directory>${project.build.directory}/pdi-ce/data-integration/plugins</directory>
                              <outputDirectory>overlay/plugins</outputDirectory>
                            </fileSet>
                            <fileSet>
                              <directory>${pdi-plugin-tester.docker-dir}/pentaho-server</directory>
                              <includes>
                                <include>prepare-server.sh</include>
                              </includes>
                              <outputDirectory>overlay</outputDirectory>
                            </fileSet>
                          </fileSets>
                        </inline>
                      </assembly>
                    </assemblies>
                    <runCmds>
                      <run>sh /tmp/docker-it/overlay/prepare-server.sh</run>
                    </runCmds>
                  </build>
                  <run>
                    <skip>${pdi-plugin-tester.skip-pentaho-server-container}</skip>
                    <containerNamePattern>pentaho-server-%t</containerNamePattern>
                    <platform>linux/amd64</platform>
                    <entryPoint>
                      <arg>/bin/sh</arg>
                      <arg>-c</arg>
                      <arg>tail -f /dev/null</arg>
                    </entryPoint>
                    <network>
                      <mode>custom</mode>
                      <name>${pdi-plugin-tester.test-network-name}</name>
                    </network>
                    <ports>
                      <port>${pdi-plugin-tester.server-host-port}:8080</port>
                    </ports>
                    <volumes>
                      <bind>
                        <volume>${pdi-plugin-tester.ssh-dir}/test-keys/test_rsa:/tmp/docker-it/ssh/test_rsa:ro</volume>
                      </bind>
                    </volumes>
                  </run>
                </image>

                <!-- SSH servers and HTTP proxies of ssh-test-environment/docker-compose.yml. -->
                <image>
                  <name>alpine:latest</name>
                  <alias>pdi-ssh-password</alias>
                  <run>
                    <skip>${pdi-plugin-tester.skip-ssh-containers}</skip>
                    <containerNamePattern>ssh-password-%t</containerNamePattern>
                    <platform>linux/amd64</platform>
                    <entryPoint>
                      <arg>/bin/sh</arg>
                      <arg>/docker-it/start-password-server.sh</arg>
                    </entryPoint>
                    <network>
                      <mode>custom</mode>
                      <name>${pdi-plugin-tester.test-network-name}</name>
                      <alias>pdi-ssh-password</alias>
                    </network>
                    <ports>
                      <port>22</port>
                    </ports>
                    <wait>
                      <tcp>
                        <mode>mapped</mode>
                        <ports>22</ports>
                      </tcp>
                      <time>${pdi-plugin-tester.startup-timeout-ms}</time>
                    </wait>
                    <volumes>
                      <bind>
                        <volume>${pdi-plugin-tester.docker-dir}/ssh:/docker-it:ro</volume>
                      </bind>
                    </volumes>
                  </run>
                </image>
                <image>
                  <name>alpine:latest</name>
                  <alias>pdi-ssh-publickey</alias>
                  <run>
                    <skip>${pdi-plugin-tester.skip-ssh-containers}</skip>
                    <containerNamePattern>ssh-publickey-%t</containerNamePattern>
                    <platform>linux/amd64</platform>
                    <entryPoint>
                      <arg>/bin/sh</arg>
                      <arg>/docker-it/start-publickey-server.sh</arg>
                    </entryPoint>
                    <network>
                      <mode>custom</mode>
                      <name>${pdi-plugin-tester.test-network-name}</name>
                      <alias>pdi-ssh-publickey</alias>
                    </network>
                    <ports>
                      <port>22</port>
                    </ports>
                    <wait>
                      <tcp>
                        <mode>mapped</mode>
                        <ports>22</ports>
                      </tcp>
                      <time>${pdi-plugin-tester.startup-timeout-ms}</time>
                    </wait>
                    <volumes>
                      <bind>
                        <volume>${pdi-plugin-tester.docker-dir}/ssh:/docker-it:ro</volume>
                        <volume>${pdi-plugin-tester.ssh-dir}/test-keys/test_rsa.pub:/tmp/authorized_keys:ro</volume>
                      </bind>
                    </volumes>
                  </run>
                </image>
                <image>
                  <name>wenbushi/ngx_http_proxy_connect:latest</name>
                  <alias>pdi-http-proxy</alias>
                  <run>
                    <skip>${pdi-plugin-tester.skip-ssh-containers}</skip>
                    <containerNamePattern>http-proxy-%t</containerNamePattern>
                    <platform>linux/amd64</platform>
                    <network>
                      <mode>custom</mode>
                      <name>${pdi-plugin-tester.test-network-name}</name>
                      <alias>pdi-http-proxy</alias>
                    </network>
                    <ports>
                      <port>3128</port>
                    </ports>
                    <wait>
                      <tcp>
                        <mode>mapped</mode>
                        <ports>3128</ports>
                      </tcp>
                      <time>${pdi-plugin-tester.startup-timeout-ms}</time>
                    </wait>
                    <volumes>
                      <bind>
                        <volume>${pdi-plugin-tester.ssh-dir}/nginx-proxy.conf:/etc/nginx/nginx.conf:ro</volume>
                      </bind>
                    </volumes>
                  </run>
                </image>
                <image>
                  <name>ubuntu/squid:latest</name>
                  <alias>pdi-http-proxy-auth</alias>
                  <run>
                    <skip>${pdi-plugin-tester.skip-ssh-containers}</skip>
                    <containerNamePattern>http-proxy-auth-%t</containerNamePattern>
                    <platform>linux/amd64</platform>
                    <network>
                      <mode>custom</mode>
                      <name>${pdi-plugin-tester.test-network-name}</name>
                      <alias>pdi-http-proxy-auth</alias>
                    </network>
                    <ports>
                      <port>3128</port>
                    </ports>
                    <wait>
                      <tcp>
                        <mode>mapped</mode>
                        <ports>3128</ports>
                      </tcp>
                      <time>${pdi-plugin-tester.startup-timeout-ms}</time>
                    </wait>
                    <volumes>
                      <bind>
                        <volume>${pdi-plugin-tester.ssh-dir}/squid.conf:/etc/squid/squid.conf:ro</volume>
                        <volume>${pdi-plugin-tester.ssh-dir}/squid-passwords:/etc/squid/passwords:ro</volume>
                      </bind>
                    </volumes>
                  </run>
                </image>
              </images>
            </configuration>
            <executions>
              <execution>
                <id>setup-containers</id>
                <phase>pre-integration-test</phase>
                <goals>
                  <goal>build</goal>
                  <goal>start</goal>
                </goals>
              </execution>
              <execution>
                <id>teardown-containers</id>
                <phase>post-integration-test</phase>
                <goals>
                  <goal>stop</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-failsafe-plugin</artifactId>
            <version>3.5.2</version>
            <configuration>
              <includes>
                <include>**/*IT.java</include>
              </includes>
              <groups>${groups}</groups>
              <excludedGroups>${excludedGroups}</excludedGroups>
              <rerunFailingTestsCount>${rerunFailingTestsCount}</rerunFailingTestsCount>
              <systemPropertyVariables>
                <pdiContainerId>${docker.container.pdi.id}</pdiContainerId>
                <pentahoServerContainerId>${docker.container.pentaho-server.id}</pentahoServerContainerId>
                <postgresContainerId>${docker.container.postgresDatabase.id}</postgresContainerId>
                <pdi-plugin-tester.execution-types>${pdi-plugin-tester.execution-types}</pdi-plugin-tester.execution-types>
                <pdi-plugin-tester.pdi-home>${pdi-plugin-tester.pdi-home}</pdi-plugin-tester.pdi-home>
                <pdi-plugin-tester.server-home>${pdi-plugin-tester.server-home}</pdi-plugin-tester.server-home>
                <pdi-plugin-tester.carte-host-port>${pdi-plugin-tester.carte-host-port}</pdi-plugin-tester.carte-host-port>
                <pdi-plugin-tester.server-host-port>${pdi-plugin-tester.server-host-port}</pdi-plugin-tester.server-host-port>
                <pdi-plugin-tester.startup-timeout-ms>${pdi-plugin-tester.startup-timeout-ms}</pdi-plugin-tester.startup-timeout-ms>
                <pdi-plugin-tester.server-startup-timeout-ms>${pdi-plugin-tester.server-startup-timeout-ms}</pdi-plugin-tester.server-startup-timeout-ms>
              </systemPropertyVariables>
            </configuration>
            <executions>
              <execution>
                <goals>
                  <goal>integration-test</goal>
                  <goal>verify</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
